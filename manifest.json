{
  "manifest_version": 3,
  "name": "EXTREAMIX",
  "version": "1.0.0",
  "description": "High-performance multimodal synthesis and routing command center.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "displayCapture"
  ],
  "action": {
    "default_title": "Open EXTREAMIX"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
